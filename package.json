{
  "name": "@simhub2/justflipit",
  "version": "4.0.1",
  "description": "Responsive flip and tilt animations with React, Vue, Svelte and agent tool adapters",
  "main": "./dist/justFlipIt.cjs",
  "module": "./dist/justFlipIt.mjs",
  "browser": "./dist/justFlipIt.js",
  "unpkg": "dist/justFlipIt.min.js",
  "jsdelivr": "dist/justFlipIt.min.js",
  "types": "./dist/justFlipIt.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/justFlipIt.d.mts",
        "default": "./dist/justFlipIt.mjs"
      },
      "require": {
        "types": "./dist/justFlipIt.d.cts",
        "default": "./dist/justFlipIt.cjs"
      }
    },
    "./modern": {
      "import": {
        "types": "./dist/justFlipIt.d.mts",
        "default": "./dist/justFlipIt.mjs"
      },
      "require": {
        "types": "./dist/justFlipIt.d.cts",
        "default": "./dist/justFlipIt.cjs"
      }
    },
    "./vanilla": {
      "import": {
        "types": "./dist/justFlipIt.d.mts",
        "default": "./dist/justFlipIt.mjs"
      },
      "require": {
        "types": "./dist/justFlipIt.d.cts",
        "default": "./dist/justFlipIt.cjs"
      }
    },
    "./combined": {
      "import": {
        "types": "./dist/justFlipIt.d.mts",
        "default": "./dist/justFlipIt.mjs"
      },
      "require": {
        "types": "./dist/justFlipIt.d.cts",
        "default": "./dist/justFlipIt.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.mts",
        "default": "./dist/vue.mjs"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./svelte": {
      "import": {
        "types": "./dist/svelte.d.mts",
        "default": "./dist/svelte.mjs"
      },
      "require": {
        "types": "./dist/svelte.d.cts",
        "default": "./dist/svelte.cjs"
      }
    },
    "./agent": {
      "import": {
        "types": "./dist/agent.d.mts",
        "default": "./dist/agent.mjs"
      },
      "require": {
        "types": "./dist/agent.d.cts",
        "default": "./dist/agent.cjs"
      }
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc -p tests/tsconfig.json",
    "check": "npm test && npm run typecheck",
    "prepublishOnly": "npm run check",
    "deploy:pages": "./update-gh-pages.sh"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "vue": "^3.5.0",
    "svelte": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3",
    "svelte": ">=4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimHub/justFlipIt.git"
  },
  "bugs": {
    "url": "https://github.com/SimHub/justFlipIt/issues"
  },
  "homepage": "https://github.com/SimHub/justFlipIt#readme",
  "author": "SimHub <simhub.dev@gmail.com>",
  "license": "MIT",
  "keywords": [
    "flip",
    "animation",
    "tilt",
    "react",
    "vue",
    "svelte",
    "agent",
    "3d",
    "typescript"
  ]
}
